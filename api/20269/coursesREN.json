aInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": null, "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "This course explores the intellectual and historical contexts of the Renaissance book and applies a digital humanities approach to its study, focusing on books printed in Western Europe between 1500 and 1700. Through a close examination of early and rare books, students explore three major areas in Renaissance intellectual history: 1) humanist rhetoric, politics, and literature, 2) Reformation studies, and 3) natural history, science, and medicine. Regular guest lectures sponsored by the Centre for Reformation and Renaissance Studies will introduce students to scholars from beyond the UofT; the course also involves experiential learning with digital exhibitions and rare books.", "title": "The Renaissance Book", "levelOfInstruction": "undergraduate", "prerequisitesText": "Completion of 9.0 credits", "corequisitesText": null, "exclusionsText": "VIC442H1; VIC449H1 (Advanced Seminar in the Renaissance: Exhibiting the Renaissance Book), offered in Winter 2018 and Winter 2019", "recommendedPreparation": "REN240Y1, or another course in Renaissance Studies", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Society and its Institutions (3)"], "distributionRequirements": ["Humanities"], "publicationSections": ["Victoria College"], "cmPublicationSections": [{"section": "Victoria College", "subSections": ["VIC-Renaissance Studies"]}]}, "created": "2026-04-21@23:20:00.296", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "VIC", "name": "Victoria College"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadt