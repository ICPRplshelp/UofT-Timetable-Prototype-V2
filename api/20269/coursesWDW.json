": "1", "post": {"code": "", "name": ""}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "", "name": ""}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 21, "sequence": 1}, {"yearOfStudy": "*", "post": {"code": "AS   NDEGS", "name": "SEE WDW"}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "", "name": ""}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 4, "sequence": 2}], "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "The land now known as Toronto has a 13,000+ year old history of Indigenous presence that is still unfolding. This history is inscribed in the land \u2013 it is visible in the geographical features, place names, and contemporary urban form of the city and is represented through stories (oral and written) told by diverse members of Toronto\u2019s Indigenous community. This course engages with stories of Indigenous history and presence in Toronto through a selection of Indigenous literary works about Toronto, Indigenous guest speakers, and a series of experiential Indigenous storytelling tours of significant locations across the city. Students will be introduced to Indigenous worldviews and ways of knowing and will learn why storytelling remains a significant and culturally-appropriate means for keeping and sharing land-based Indigenous Knowledge. Students will gain a deeper appreciation of the city as a traditional Indigenous territory and will reflect on their own relationships and responsibilities within these lands. Restricted to first-year students. Not eligible for CR/NCR option.", "title": "Indigenous Knowledge and Storytelling in Toronto", "levelOfInstruction": "undergraduate", "prerequisitesText": "", "corequisitesText": null, "exclusionsText": null, "recommendedPreparation": null, "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Creative and Cultural Representations (1)"], "distributionRequirements": ["Humanities"], "publicationSections": ["Woodsworth College", "First-Year Foundations"], "cmPublicationSections": [{"section": "Woodsworth College", "subSections": null}, {"section": "First-Year Foundations", "subSections": null}]}, "created": "2026-06-16@22:47:35.599", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "WDW", "name": "Woodsworth College"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "APSC", "name": "Faculty of Applied Science & Engineering"}, "breadthTypes": [{"kind": "ELECTIVE", "type": "Compl Studies", "description": "Complementary Studies", "code": "CS"}]}, {"org": {"code": "ERIN", "name": "University of Toronto Mississauga"}, "breadthTypes": []}, {"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Creative Cultural", "description": "BR=1 Creative and Cultural Representation", "code": "BR=1"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": "<p><strong>Timetable Instructions</strong></p><p>This course is restricted to year 1 students (0 to 3.5 FCEs) in the Faculty of Arts and Science.</p>"}], "cancelInd": "N", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "primaryWaitlistable": false, "fullyOnline": false, "primaryFull": false}]}