AJ1446A", "name": "Cognitive Science Major - Science: Computational Cognition Stream"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 180, "sequence": 11}, {"yearOfStudy": "*", "post": {"code": "", "name": ""}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "ASMAJ1446B", "name": "Cognitive Science Major - Science: Cognition and the Brain Stream"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 180, "sequence": 12}, {"yearOfStudy": "*", "post": {"code": "", "name": ""}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "ASMIN1160", "name": "Psychology Minor"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 180, "sequence": 13}, {"yearOfStudy": "*", "post": {"code": "", "name": ""}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "ASSPE1160", "name": "Psychology Specialist"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 180, "sequence": 14}, {"yearOfStudy": "*", "post": {"code": "", "name": ""}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "ASSPE1958", "name": "Psychology Research Specialist - Thesis"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 180, "sequence": 15}], "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "Psycholinguistics focuses on how language is learned, processed, understood, and produced by the human mind. Through a blend of theory and experimental evidence, the course examines how children acquire language since the earliest stages of development. Topics include infants\u2019 abilities at birth, cognitive development, word-learning, phonological, syntactic and semantic development and conversational abilities. Students will engage with foundational research methods in language acquisition, including behavioral methods and child language corpora, and will critically evaluate how experimental findings inform theories of language development. By the end of the course, students will have a deeper understanding of how humans acquire their first language and how language learning interacts with other aspects of cognitive development. (Sponsored by the Departments of Linguistics and Psychology, but administered solely by the Dept. of Linguistics).", "title": "Psycholinguistics: Language Acquisition in Children", "levelOfInstruction": "undergraduate", "prerequisitesText": "1.0 credit at the 200+ level in LIN/JAL/JUP/PSL/PSY/COG", "corequisitesText": "", "exclusionsText": "PSY315H5, PLIC24H3 ", "recommendedPreparation": "", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Thought, Belief and Behaviour (2)"], "distributionRequirements": ["Science"], "publicationSections": ["Linguistics", "Psychology"], "cmPublicationSections": [{"section": "Linguistics", "subSections": null}, {"section": "Psychology", "subSections": null}]}, "created": "2026-06-16@22:46:40.803", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "PSY", "name": "Department of Psychology"}, "department": {"code": "LIN", "name": "Department of Linguistics"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "APSC", "name": "Faculty of Applied Science & Engineering"}, "breadthTypes": [{"kind": "ELECTIVE", "type": "Compl Studies", "description": "Complementary Studies", "code": "CS"}]}, {"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Thought", "description": "BR=2 Thought, Belief and Behaviour", "code": "BR=2"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": ""}], "cancelInd": "", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "primaryWaitlistable": false, "fullyOnline": false, "primaryFull": false}, {"id": "69d94299830c3634bbb693c3", "name": "Language Development", "ucName": null, "code": "JLP315H5", "sectionCode": "F", "campus": "University of Toronto at Mississauga", "sessions": ["20269"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": [{"start": {"day": 2, "millisofday": 43200000}, "end": {"day": 2, "millisofday": 54000000}, "building": {"buildingCode": "MN", "buildingRoomNumber": "", "buildingRoomSuffix": "", "buildingUrl": "https://map.utoronto.ca/?id=1809#!m/495122", "buildingName": null}, "sessionCode": "20269", "repetition": "WEEKLY", "repetitionTime": "ONCE_A_WEEK"}], "firstMeeting": null, "instructors": [{"firstName": "Christina M Vanden Bosc", "lastName": "der Nederlanden"}], "currentEnrolment": 0, "maxEnrolment": 55, "subTitle": "