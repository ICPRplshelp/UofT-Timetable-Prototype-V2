orks that define the power relationships between the stakeholders: government science policymakers, research and educational institutions, private firms, social media, and NGOs.", "title": "Science Policy ", "levelOfInstruction": null, "prerequisitesText": "<p>Completion of 4.0 credits</p>", "corequisitesText": null, "exclusionsText": "<p>VIC302H1</p>", "recommendedPreparation": null, "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Society and its Institutions (3)"], "distributionRequirements": ["Social Science"], "publicationSections": ["Victoria College"], "cmPublicationSections": [{"section": "Victoria College", "subSections": ["VIC-Science, Technology, and Society"]}]}, "created": "2026-04-21@23:20:05.222", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "VIC", "name": "Victoria College"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Society Institutions", "description": "BR=3 Society and Its Institutions", "code": "BR=3"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": ""}], "cancelInd": "", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}, {"id": "69dd3ea4830c3634bbb6a62d", "name": "Special Topics in Science, Technology and Society", "ucName": null, "code": "STS377H1", "sectionCode": "F", "campus": "St. George", "sessions": ["20269"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [