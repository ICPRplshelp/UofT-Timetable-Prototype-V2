{"courses": [{"id": "69dd3ea4830c3634bbb6a62b", "name": "Public Communication in Science", "ucName": null, "code": "STS301H1", "sectionCode": "S", "campus": "St. George", "sessions": ["20271"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [], "currentWaitlist": null, "enrolmentInd": null, "tbaInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": null, "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "How can scientific findings be efficiently communicated to broader audiences? This course will focus on the methodologies of effective science communication by analyzing the range of available tools, principles, formats, and media. It will introduce students to various techniques of communicating scientific findings to non-specialist audiences by means of social media posts, videos, podcasts, comics, interviews, news briefs, and public speaking. Students will analyze the public\u2019s perception of science and will discuss ways to address the concerns of science skeptics. Students will have the opportunity to create various forms of science communications material.", "title": "Public Communication in Science ", "levelOfInstruction": null, "prerequisitesText": "<p>Completion of 4.0 credits</p>", "corequisitesText": null, "exclusionsText": "<p>VIC301H1</p>", "recommendedPreparation": null, "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Society and its Institutions (3)"], "distributionRequirements": ["Social Science"], "publicationSections": ["Victoria College"], "cmPublicationSections": [{"section": "Victoria College", "subSections": ["VIC-Science, Technology, and Society"]}]}, "created": "2026-