{"courses": [{"id": "69dd3ea4830c3634bbb69964", "name": "Beyond the Bible: The Books that Created Judaism", "ucName": null, "code": "CJS195H1", "sectionCode": "F", "campus": "St. George", "sessions": ["20269"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [], "currentWaitlist": null, "enrolmentInd": null, "tbaInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": null, "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "This course introduces the books that transformed Judaism. We will explore how these books were products of their time as well as what led later Jewish communities to embrace them. Texts will be drawn from a wide variety of genres including philosophy, mysticism, theology, poetry, law, history, biography, and fiction. Through close reading and discussion, participants will gain insight into Jewish history and its literary heritage. All readings will be given in English. No prior knowledge of Judaism is required. Restricted to first-year students. Not eligible for CR/NCR option.", "title": "Beyond the Bible: The Books that Created Judaism", "levelOfInstruction": null, "prerequisitesText": "", "corequisitesText": "", "exclusionsText": "<p>CJS205H1</p>", "recommendedPreparation": "", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Thought, Belief and Behaviour (2)"], "distributionRequirements": ["Humanities"], "publicationSections": ["First-Year Foundations", "Centre for Jewish Studies"], "cmPublicationSections": [{"section": "First-Year Foundations", "subSections": null}, {"section": "Centre for Jewish Studies", "subSections": null}]}, "created": "2026-04-21@23:19:36.416", "modif