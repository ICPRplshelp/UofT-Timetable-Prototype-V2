fo": {"description": "Studies on an individual writer or specific area of literature. For more information, see https://www.french.utoronto.ca/course-offerings-2020-2021/french-cultural-studies-courses-fcs.", "title": "Special Topics in French Cultural Studies II", "levelOfInstruction": "undergraduate", "prerequisitesText": "Completion of 4.0 credits", "corequisitesText": "", "exclusionsText": "", "recommendedPreparation": "", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Creative and Cultural Representations (1)"], "distributionRequirements": ["Humanities"], "publicationSections": ["French"], "cmPublicationSections": [{"section": "French", "subSections": ["French-Cultural Studies"]}]}, "created": "2026-04-21@23:19:45.216", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "FRE", "name": "Department of French"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "APSC", "name": "Faculty of Applied Science & Engineering"}, "breadthTypes": [{"kind": "ELECTIVE", "type": "Compl Studies", "description": "Complementary Studies", "code": "CS"}]}, {"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Creative Cultural", "description": "BR=1 Creative and Cultural Representation", "code": "BR=1"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": "<p><strong>Timetable Instructions</strong></p><p>An introduction to major thinkers and intellectual traditions in France in the 20th and 21st century, in particular the French version of cultural studies. The course will engage with the legacy of structuralism, marxism, semiotics and discourse analysis as presented by thinkers like Saussure, Barthes, Fanon, Althusser, Bourdieu, Baudrillard, Lyotard, Foucault, de Certeau, etc. By presenting French theory within the larger framework of intellectual history and by focusing on the emergence of (post)modern subjectivity and the multimedia landscape of cultural production, this course provides an access to historical and philosophical debates which shape the humanities today. &nbsp;Course may not be repeated under the same subtitle.</p>"}], "cancelInd": "", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}]}