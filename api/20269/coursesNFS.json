 "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Living Things", "description": "BR=4 Living Things and Their Environment", "code": "BR=4"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": ""}], "cancelInd": "N", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}, {"id": "69dd3ea4830c3634bbb6a157", "name": "Advanced Clinical Nutrition", "ucName": null, "code": "NFS311H1", "sectionCode": "S", "campus": "St. George", "sessions": ["20271"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [], "currentWaitlist": null, "enrolmentInd": null, "tbaInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": null, "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "This course builds on the concepts introduced in Introduction to Clinical Nutrition (NFS310H), with a focus on advanced interventions for complex medical conditions. This course explores medical nutrition therapy for acute and chronic diseases such as kidney disease, cancer, gastrointestinal disorders, and critical care. Students will engage with advanced nutritional biochemistry, evaluate the impact of emerging research, and refine their ability to develop comprehensive, patient-centred care plans. Case-based learning and interactive discussions will foster critical thinking and the integration of nutrition science into clinical practice. By the end of the course, students will be equipped to address complex nutritional challenges in diverse healthcare settings.", "title": "Advanced Clinical Nutrition ", "levelOfInstruction": null, "prerequisitesText": "<p>NFS284H1, NFS310H1</p>", "corequisitesText": null, "exclusionsText": null, "recommendedPreparation": null, "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Living Things and Their Environment (4)"], "distributionRequirements": ["Science"], "publicationSections": ["Nutritional Sciences"], "cmPublicationSections": [{"section": "Nutritional Sciences", "subSections": null}]}, "created": "2026-04-21@23:19:54.331", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "NUSCI", "name": "Department of Nutritional Sciences"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": [{"kind": "BREADTH", "type": "Living Things", "description": "BR=4 Living Things and Their Environment", "code": "BR=4"}]}], "notes": [{"name": "Course Note", "type": "COURSE", "content": ""}], "cancelInd": "", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}, {"id": "69dd3ea4830c3634bbb6a158", "name": "Vitamin and Mineral Metabolism Throughout the Life Cycle", "ucName": null, "code": "NFS382H1", "sectionCode": "S", "campus": "St. George", "sessions": ["20271"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [], "currentWaitlist": null, "enrolmentInd": null, "tbaInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "con