1", "meetingTimes": null, "firstMeeting": null, "instructors": null, "currentEnrolment": null, "maxEnrolment": null, "subTitle": null, "cancelInd": null, "waitlistInd": null, "deliveryModes": [], "currentWaitlist": null, "enrolmentInd": null, "tbaInd": null, "openLimitInd": null, "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": null, "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "It has long been said that the material culture of the Renaissance generated the first stir of consumerism with a variety of artifacts produced from 1400 to 1700 in Italy. This course explores the material culture of Renaissance consumerism and discusses the production and function of works in different art media.", "title": "Art and Consumers in the Renaissance (1400-1700)", "levelOfInstruction": "undergraduate", "prerequisitesText": "<p>1.0 FAH credit</p>", "corequisitesText": "", "exclusionsText": "", "recommendedPreparation": "<p>FAH230H1/ FAH231H1/ FAH274H5/ FAH279H5/ VPHB64H3/ VPHB74H3</p>", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["Creative and Cultural Representations (1)"], "distributionRequirements": ["Humanities"], "publicationSections": ["Art History"], "cmPublicationSections": [{"section": "Art History", "subSections": null}]}, "created": "2026-01-24@20:57:49.565", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "FAR", "name": "Department of Art History"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "APSC", "name": "Faculty of Applied Science & Engineering"}, "breadthTypes": [{"kind": "ELECTIVE", "type": "Compl Studies", "description": "Complementary Studies", "code": "CS"}]}, {"org": {"code": "ERIN", "name": "University of Toronto Mississauga"}, "breadthTypes": [{"kind": "DISTRIBU