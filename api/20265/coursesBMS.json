"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 25, "sequence": 7}], "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "This course is an advanced seminar on the history of books and media. Students can expect to take an active role in leading course discussions and developing their own research projects. The exact topic will change depending on the instructor. In some terms this course may require an application. This will be clearly noted in the Timetable.", "title": "Advanced Topics in Book & Media Histories", "levelOfInstruction": "undergraduate", "prerequisitesText": "<p>Completion of 10.0 credits including 2.0 BMS credits. Students who do not meet these prerequisites are encouraged to contact the unit.</p>", "corequisitesText": "", "exclusionsText": "", "recommendedPreparation": "", "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": ["None"], "distributionRequirements": ["Humanities"], "publicationSections": ["St. Michael's College"], "cmPublicationSections": [{"section": "St. Michael's College", "subSections": ["SMC-Book and Media Studies"]}]}, "created": "2026-04-21@23:18:42.421", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "SMC", "name": "St. Michael's College"}, "title": null, "maxCredit": 0.5, "minCredit": 0.5, "breadths": [{"org": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "breadthTypes": []}], "notes": [{"name": "Course Note", "type": "COURSE", "content": "<p><strong>Timetable Instructions</strong></p><p><strong>LEC0101 - Crime in print: from the early modern period to Victorian Britain</strong></p><p>This course will examine a variety of early modern popular printed texts to survey the history, development, and growing popularity of crime-related literature in an array of print media between the sixteenth to the nineteenth century. We will investigate how convergence between crime, religion, and multiple genres of popular literature both catered to and re-shaped popular readership. We will look at a wide variety of texts: early print versions of outlaw stories, chapbooks and broadsides about famous criminals, plays such as Middleton\u2019s and Dekker\u2019s <i>Roaring Girl</i>, criminal conversion narratives and execution sermons, excerpts from the Newgate Calendar, Gothic penny dreadfuls, true crime Victorian newspaper reports (the Red Barn Murder, Jack the Ripper), as well as Victorian short stories.</p>"}], "cancelInd": "", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}, {"id": "696f7d2320609159511a65f5", "name": "Independent Study in Book and Media Studies", "ucName": null, "code": "BMS494H1", "sectionCode": "F", "campus": "St. George", "sessions": ["20265F"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": [], "firstMeeting": null, "instructors": [], "currentEnrolment": 0, "maxEnrolment": 9999, "subTitle": "", "cancelInd": "N", "waitlistInd": "N", "deliveryModes": [{"session": "20265F", "mode": "INPER"}], "currentWaitlist": 0, "enrolmentInd": "E", "tbaInd": "Y", "openLimitInd": "N", "notes": [{"name": "Section Note", "type": "SECTION", "content": ""}], "enrolmentControls": [{"yearOfStudy": "*", "post": {"code": "*", "name": "All"}, "subject": {"code": "*", "name": "All"}, "subjectPost": {"code": "*", "name": "All"}, "typeOfProgram": {"code": "*", "name": "All"}, "designation": {"code": "*", "name": "All"}, "primaryOrg": {"code": "*", "name": "All"}, "associatedOrg": {"code": "*", "name": "All"}, "secondOrg": {"code": "*", "name": "All"}, "adminOrg": {"code": "*", "name": "All"}, "collaborativeOrgGroupCode": "*", "quantity": 9999, "sequence": 1}], "linkedMeetingSections": null}], "duration": null, "cmCourseInfo": {"description": "An independent research project to be proposed by the student and supervised by a full-time faculty member affiliated with the Book & Media Studies Program. A full proposal including a course description, working bibliography, marking scheme, and approval from your academic supervisor must be submitted for approval by the Program Coordinator and Director. More information and application forms are available at https://stmikes.utoronto.ca/academic-forms or from the SMC Principal's Office, smc.programs@utoronto.ca. Completed forms must be submitted to the Principal's Office by the first day of classes in September/May for F courses, or January/July for S courses. Meeting times are determined in consultation with your supervisor, and may be in person or online as appropriate. Students must have approval of an instructor willing to supervise the project. Final approval is granted by the program director. Not eligible for CR/NCR option.", "title": "Independent Study in Book and Media Studies", "levelOfInstruction": "undergraduate", "prerequisitesText": "<p>Students must be enrolled in a BMS Major program and have taken 10.0 credits including at least 6.0 BMS credits with at least a B+ average.\u00a0</p>", "corequisitesText": null, "exclusionsText": "<p>BMS495Y1</p>", "recommendedPreparation": null, "note": null, "division": "Arts and Science, Faculty of", "breadthRequirements": null, "distributionRequirements": null, "publicationSections": ["St. Michael's College"], "cmPublicationSections": [{"section": "St. Michael's College", "subSections": ["SMC-Book and Media Studies"]}]}, "created": "2026-04-21@23:18:42.421", "modified": null, "lastSaved": 0, "primaryTeachMethod": "LEC", "faculty": {"code": "ARTSC", "name": "Faculty of Arts and Science"}, "coSec": {"code": "", "name": null}, "department": {"code": "SMC",