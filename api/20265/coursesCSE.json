Credit": 0.5, "breadths": [], "notes": [{"name": "Course Note", "type": "COURSE", "content": "<p><strong>Timetable Instructions</strong></p><p><strong>CSE441H1: Art, Cultural Production, and Resistance - </strong>Examines the historical, political, economic and social conditions that produced various resistance movements across the world through an anti-colonial, anti-capitalist, anti-racist, anti-imperialist, feminist lens. Encourages students, educators, artists and activists to consider the role of cultural production within contemporary social movements, particularly decolonization struggles, both locally and globally.</p>"}], "cancelInd": "N", "subscriptionTtb": false, "subscriptionOpenData": false, "tb1Active": false, "tb2Active": false, "fullyOnline": false, "primaryFull": false, "primaryWaitlistable": false}, {"id": "696f7d2320609159511a6646", "name": "Anti-Colonization and the Politics of Violence", "ucName": null, "code": "CSE444H1", "sectionCode": "F", "campus": "St. George", "sessions": ["20265F"], "sections": [{"name": "LEC0101", "type": "Lecture", "teachMethod": "LEC", "sectionNumber": "0101", "meetingTimes": [{"start": {"day": 1, "millisofday": 46800000}, "end": {"day": 1, "millisofday": 57600000}, "building": {"buildingCode": "SS", "buildingRoomNumber": "", "buildingRoomSuffix": "", "buildingUrl": "https://map.utoronto.ca/?id=1809#!m/494510", "buildingName": null}, "sessionCode": "20265F", "repetition": "WEEKLY", "repetitionTime": "ONCE_A_WEEK"}, {"start": {"day": 3, "millisofday": 46800000}, "end": {"day": 3, "millisofday": 57600000}, "building": {"buildingCode": "SS", "buildingRoomNumber": "", "buildingRoomSuffix": "", "buildingUrl": "https://map.utoronto.ca/?id=1809#!m/494510", "buildingName": null}, "sessionCode": "20265F", "repetition": "WEEKLY", "repetitionTime": "ONCE_A_WEEK"}], "firstMeeting": null, "instructors": [{"firstName": "David", "lastName": "Chin"}], "currentEnrolment": 6, "maxEnrolment": 25, "subTitle": "", "cancelInd": "N", "waitli